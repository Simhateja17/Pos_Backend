          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "customerSearch",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching sales",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sale"
