{
  "openapi": "3.1.0",
  "info": {
    "title": "Couture POS API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "manager",
                  "cashier"
                ]
              },
              "tenantId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "email",
              "role",
              "tenantId"
            ]
          },
          "session": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              }
            },
            "required": [
              "accessToken",
              "refreshToken"
            ]
          }
        },
        "required": [
          "user",
          "session"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "ownerName": {
            "type": "string",
            "minLength": 1
          },
          "businessName": {
            "type": "string",
            "minLength": 1
          },
          "addressLine1": {
            "type": "string",
            "minLength": 1
          },
          "addressLine2": {
            "type": "string"
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "postalCode": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "default": "US"
          },
          "taxId": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "ownerName",
          "businessName",
          "addressLine1",
          "city",
          "state",
          "postalCode"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "cashier"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "isActive",
          "createdAt"
        ]
      },
      "InviteMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "manager",
              "cashier"
            ]
          }
        },
        "required": [
          "email",
          "name",
          "role"
        ]
      },
      "UpdateMemberRoleRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "cashier"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            }
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "createdAt",
          "variants"
        ]
      },
      "Variant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "size": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "material": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": "string"
          },
          "reorderThreshold": {
            "type": "integer"
          },
          "identityLocked": {
            "type": "boolean"
          },
          "currentStock": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "productId",
          "sku",
          "size",
          "color",
          "material",
          "price",
          "reorderThreshold",
          "identityLocked",
          "currentStock",
          "createdAt"
        ]
      },
      "CreateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[A-Za-z0-9-]+$"
                },
                "size": {
                  "type": "string",
                  "maxLength": 50
                },
                "color": {
                  "type": "string",
                  "maxLength": 50
                },
                "material": {
                  "type": "string",
                  "maxLength": 50
                },
                "price": {
                  "type": "number",
                  "minimum": 0
                },
                "reorderThreshold": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "price"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "variants"
        ]
      },
      "UpdateVariantRequest": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string",
            "maxLength": 50
          },
          "color": {
            "type": "string",
            "maxLength": 50
          },
          "material": {
            "type": "string",
            "maxLength": 50
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "reorderThreshold": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "StockMovement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "movementType": {
            "type": "string",
            "enum": [
              "sale",
              "receive",
              "adjustment",
              "return",
              "transfer"
            ]
          },
          "quantityDelta": {
            "type": "integer"
          },
          "reasonCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "damage",
              "shrinkage_theft",
              "count_correction",
              "other",
              null
            ]
          },
          "reasonNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "variantId",
          "movementType",
          "quantityDelta",
          "reasonCode",
          "reasonNote",
          "createdBy",
          "createdAt"
        ]
      },
      "CreateStockMovementRequest": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "movementType": {
            "type": "string",
            "enum": [
              "receive",
              "adjustment",
              "transfer"
            ]
          },
          "quantityDelta": {
            "type": "integer"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "damage",
              "shrinkage_theft",
              "count_correction",
              "other"
            ]
          },
          "reasonNote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "variantId",
          "movementType",
          "quantityDelta"
        ]
      },
      "LowStockVariant": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "size": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "material": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "integer"
          },
          "reorderThreshold": {
            "type": "integer"
          }
        },
        "required": [
          "variantId",
          "productId",
          "productName",
          "sku",
          "size",
          "color",
          "material",
          "quantity",
          "reorderThreshold"
        ]
      },
      "SetPinRequest": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "string",
            "pattern": "^\\d{4}$"
          }
        },
        "required": [
          "pin"
        ]
      },
      "PinSwitchResponse": {
        "type": "object",
        "properties": {
          "operatorToken": {
            "type": "string"
          },
          "staff": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "manager",
                  "cashier"
                ]
              }
            },
            "required": [
              "id",
              "role"
            ]
          }
        },
        "required": [
          "operatorToken",
          "staff"
        ]
      },
      "PinSwitchRequest": {
        "type": "object",
        "properties": {
          "staffId": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          }
        },
        "required": [
          "staffId",
          "pin"
        ]
      },
      "Sale": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clientSaleId": {
            "type": "string",
            "format": "uuid"
          },
          "shiftId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "customerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "subtotal": {
            "type": "string"
          },
          "discountAmount": {
            "type": "string"
          },
          "taxAmount": {
            "type": "string"
          },
          "totalAmount": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleLineItem"
            }
          },
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          }
        },
        "required": [
          "id",
          "clientSaleId",
          "shiftId",
          "customerId",
          "subtotal",
          "discountAmount",
          "taxAmount",
          "totalAmount",
          "status",
          "createdBy",
          "createdAt",
          "lines",
          "payments"
        ]
      },
      "SaleLineItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "string"
          },
          "discountPercent": {
            "type": [
              "string",
              "null"
            ]
          },
          "discountAmount": {
            "type": "string"
          },
          "isTaxable": {
            "type": "boolean"
          },
          "lineTotal": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "variantId",
          "quantity",
          "unitPrice",
          "discountPercent",
          "discountAmount",
          "isTaxable",
          "lineTotal"
        ]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "payment",
              "refund"
            ]
          },
          "amount": {
            "type": "string"
          },
          "referenceCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "saleId",
          "method",
          "direction",
          "amount",
          "referenceCode",
          "createdBy",
          "createdAt"
        ]
      },
      "CreateSaleRequest": {
        "type": "object",
        "properties": {
          "clientSaleId": {
            "type": "string",
            "format": "uuid"
          },
          "shiftId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variantId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "discountPercent": {
                  "type": "string",
                  "pattern": "^\\d{1,2}(\\.\\d{1,2})?$"
                },
                "discountAmount": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d{2}$"
                }
              },
              "required": [
                "variantId",
                "quantity"
              ]
            },
            "minItems": 1
          },
          "cartDiscountPercent": {
            "type": "string",
            "pattern": "^\\d{1,2}(\\.\\d{1,2})?$"
          },
          "cartDiscountAmount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentInput"
            },
            "minItems": 1
          },
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "phone": {
                "type": "string",
                "maxLength": 20
              },
              "email": {
                "type": "string",
                "maxLength": 200,
                "format": "email"
              }
            }
          }
        },
        "required": [
          "clientSaleId",
          "shiftId",
          "lines",
          "payments"
        ]
      },
      "PaymentInput": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "check"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "referenceCode": {
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "method",
          "amount"
        ]
      },
      "CreateReturnRequest": {
        "type": "object",
        "properties": {
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "shiftId": {
            "type": "string",
            "format": "uuid"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "saleLineItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "saleLineItemId",
                "quantity"
              ]
            },
            "minItems": 1
          },
          "refundPayments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "cash",
                    "card",
                    "check"
                  ]
                },
                "amount": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d{2}$"
                },
                "referenceCode": {
                  "type": "string",
                  "maxLength": 50
                }
              },
              "required": [
                "method",
                "amount"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "saleId",
          "shiftId",
          "lines",
          "refundPayments"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "email",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "description": "Real self-serve signup — creates a Supabase Auth user, a tenants row with the full business/tax profile, and an owner staff_members row.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "description": "An account already exists with this email"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Email+password login via Supabase Auth. Derives role/tenantId from a server-side staff_members lookup.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        }
      }
    },
    "/members": {
      "get": {
        "description": "List the caller's tenant's staff members. Requires manager or owner role.",
        "responses": {
          "200": {
            "description": "List of staff members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Member"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions"
          }
        }
      }
    },
    "/members/invite": {
      "post": {
        "description": "Invite a new staff member (manager or cashier) into the caller's tenant. Owner-only.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invite sent and staff row created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions"
          }
        }
      }
    },
    "/members/{memberId}/role": {
      "patch": {
        "description": "Change a staff member's role. Owner-only.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "memberId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberRoleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions"
          },
          "404": {
            "description": "Member not found"
          }
        }
      }
    },
    "/members/{memberId}": {
      "delete": {
        "description": "Soft-delete (deactivate) a staff member. Owner-only.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "memberId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Member deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
